<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <StartupObject>FlashToolbox.Program</StartupObject>
    <RootNamespace>FlashToolbox</RootNamespace>
    <AssemblyName>FlashToolbox</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FlashToolbox.Contracts\FlashToolbox.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="modules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
